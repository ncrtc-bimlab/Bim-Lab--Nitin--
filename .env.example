# Copy to .env before configuring Phase 2. Never commit .env or device keys.
TWIN_DB_PASSWORD=twin
GRAFANA_ADMIN_PASSWORD=replace-this-before-use

# Create an API key in ChirpStack for the LoRaWAN bulk sensor importer.
# Keep the key private in .env; never commit it or put it in a spreadsheet.
CHIRPSTACK_API_TOKEN=

# Register the first LoRaWAN device. Set these from ChirpStack; keep AppKeys
# out of this file and out of the project.
LORAWAN_DEVICE_ID=
LORAWAN_DEVICE_EUI=
LORAWAN_DEVICE_MODEL=LDS12-LWB
LORAWAN_DEVICE_LOCATION=
LORAWAN_EXPECTED_INTERVAL_S=

# Optional allowlist for the configured default LoRaWAN model (or explicitly
# configured device). Leave empty to store all finite numeric fields for models
# without a model-specific allowlist.
LORAWAN_ALLOWED_FIELDS_JSON=[]

# Optional model-specific allowlists override the default-model allowlist.
# Models added later without a specific allowlist store all finite numeric
# fields from the decoded ChirpStack `object`.
LORAWAN_ALLOWED_FIELDS_BY_MODEL_JSON=

# Optional mapping from decoded ChirpStack object field names to standard
# metric names, e.g. {"distance":"distance_mm","battery":"battery_v"}.
LORAWAN_METRIC_MAP_JSON={}

# BLE ingestion is disabled until owned beacon MAC addresses are allowlisted.
# The gateway currently publishes batched JSON on this observed topic.
BLE_MQTT_TOPIC=ble/gateway/+/advertisment
BLE_ALLOWED_MACS_JSON=[]
BLE_ALLOWED_FIELDS_BY_MODEL_JSON=
